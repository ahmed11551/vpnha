# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Telegram Bot Configuration
BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
BOT_USERNAME="asbvpn_bot"
WEBAPP_URL="https://vpn.yourdomain.com/mini-app"

# Security & CORS Configuration
ALLOWED_ORIGINS="https://t.me,https://web.telegram.org,https://vpn.yourdomain.com"
ALLOW_INSECURE_TEST_AUTH="false"
SECRET_KEY="generate-a-strong-random-secret-key-for-production"

# Payment Gateways (CryptoBot & Telegram Stars)
# Get token from @CryptoBot in Telegram: /pay -> Create App -> API Token
CRYPTO_BOT_TOKEN=""
CRYPTO_BOT_NET="mainnet"

# Marzban Panel API Configuration (Xray VLESS + Reality)
MARZBAN_HOST="https://marzban.yourdomain.com:8000"
MARZBAN_USERNAME="admin"
MARZBAN_PASSWORD="strong_admin_password"
MARZBAN_VERIFY_SSL="true"
MARZBAN_CA_BUNDLE=""

# Database Configuration (PostgreSQL in production, SQLite for local dev)
POSTGRES_USER="vpn_user"
POSTGRES_PASSWORD="vpn_secure_password"
POSTGRES_DB="vpn_service"
DATABASE_URL="postgresql+asyncpg://vpn_user:vpn_secure_password@postgres:5432/vpn_service"
# Or SQLite: DATABASE_URL="sqlite+aiosqlite:///./vpn_service.db"

# Commercial Logic Settings
FREE_TRIAL_DAYS="3"
TRIAL_TRAFFIC_GB="5"
REFERRAL_BONUS_RUB="100.0"
REFERRAL_COMMISSION_PERCENT="15.0"

# Administration (Comma-separated Telegram User IDs)
ADMIN_IDS="123456789"
